<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!--
	  App Group identifier MUST be prefixed with the Team ID
	  (YZXWMJ5VBY) on macOS Sequoia 15+. The legacy "group." prefix
	  triggers the kTCCServiceSystemPolicyAppData prompt — "Pacer
	  would like to access data from other apps" — on every launch
	  even with Developer ID + notarization + populated csreq. Apps
	  that don't prompt (iTerm, Stats, Raycast, OrbStack) all use
	  <TeamID>.<bundleid>. See docs/research/tcc-app-management.md
	  for the full investigation.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>YZXWMJ5VBY.com.ericandrechek.pacer</string>
	</array>
	<!--
	  Force get-task-allow=false even on Debug builds. Xcode auto-
	  injects it as true for development signing so a debugger can
	  attach, but Pacer is run from /Applications under launchd
	  (via `make install`), not from Xcode's Run scheme, so debugger
	  attach isn't useful. Stripping the entitlement removes one
	  "this binary is debuggable / untrusted" signal that Sequoia's
	  TCC weighs when deciding whether to persist Allow grants.
	  (It does not fully solve the every-launch
	  kTCCServiceSystemPolicyAppData prompt for Apple Development-
	  signed builds — see `docs/research/tcc-app-management.md` if
	  that note exists, or AGENTS.md "real-run bug #6" — but this
	  is a prerequisite for the Distribution-signed shipping path
	  and matches what the Sparkle release will look like.)
	-->
	<key>com.apple.security.get-task-allow</key>
	<false/>
</dict>
</plist>
