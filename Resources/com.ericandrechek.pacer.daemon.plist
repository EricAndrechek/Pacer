<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ericandrechek.pacer.daemon</string>

    <!--
        BundleProgram is a path RELATIVE to the embedding app bundle's
        root (Pacer.app). SMAppService.agent locates the app bundle on
        disk and resolves this against it. Avoids hard-coding an
        absolute path that would change when the user moves Pacer.app.
    -->
    <key>BundleProgram</key>
    <string>Contents/Library/LaunchServices/PacerDaemon</string>

    <!--
        Run as soon as the agent is loaded (i.e. on user login once
        registered) AND restart if it crashes. KeepAlive=true is the
        right default for a daemon whose job is "always be running."
    -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!--
        Throttle restarts. If the daemon crashes immediately on launch
        (e.g. SwiftData migration failure), this prevents a tight loop
        from chewing CPU.
    -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <!--
        Stderr capture for debugging. /tmp is fine for development; M7+
        will switch to os_log so this becomes optional and a future
        commit can drop these keys. The file is per-user (launchd
        substitutes nothing here, so this is shared if multiple users
        run Pacer on one Mac — acceptable for v1).
    -->
    <key>StandardErrorPath</key>
    <string>/tmp/com.ericandrechek.pacer.daemon.err.log</string>
    <key>StandardOutPath</key>
    <string>/tmp/com.ericandrechek.pacer.daemon.out.log</string>
</dict>
</plist>
