{
  "name": "pacer-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "pacer.andrechek.com: Pacer's website (Astro, served by a Cloudflare Worker with static assets)",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/csp-hashes.mjs",
    "preview": "astro preview",
    "check": "astro check && pnpm run types && tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "dev:worker": "pnpm build && wrangler dev --local",
    "deploy": "wrangler deploy && node scripts/indexnow.mjs",
    "types": "wrangler types worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.6",
    "@fontsource-variable/archivo": "5.3.0",
    "astro": "7.4.13",
    "marked": "18.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/vitest-plugin": "1.9.0",
    "playwright": "1.65.1",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  }
}
