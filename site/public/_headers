# Cloudflare Workers static-assets headers (rules are additive: when several
# match a path their headers merge, so Cache-Control is set only on specific
# paths, never on /*). Default for assets without a rule:
# `public, max-age=0, must-revalidate`. Adapted from room-planner.
#
# CSP (one line under /*):
#  - script-src 'self' 'unsafe-inline' here -> sha256 hashes in dist: built HTML has
#        inline scripts (the PostHog snippet with define:vars, small Astro scripts), whose
#        hashes change per build, so scripts/csp-hashes.mjs (run by `build`) replaces
#        'unsafe-inline' with a hash of each one. The build fails if this line is missing.
#        PostHog loads array.js and lazy bundles from *.posthog.com.
#        Cloudflare Web Analytics is on for the domain (the owner's decision,
#        2026-11-28): Cloudflare injects <script type="module" src="https://static.cloudflareinsights.com/
#        beacon.min.js/v…" integrity="sha512-…" data-cf-beacon='{…}' crossorigin="anonymous"> into
#        every HTML page (as served on 2026-11-28): an external script with its settings in a data
#        attribute, so it needs that host and no hash. Nothing else is allowed.
#  - style-src 'self' 'unsafe-inline'   Astro inlines its scoped CSS and the @font-face rule.
#  - img-src 'self' data:               screenshots are same-origin.
#  - connect-src 'self' https://*.posthog.com https://cloudflareinsights.com
#        The Web Analytics beacon posts to https://cloudflareinsights.com/cdn-cgi/rum.
#  - object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.posthog.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.posthog.com https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Hashed build output: cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pages and the text files built from them: always revalidate.
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
# The Markdown twins and the other discovery files (/.well-known/*, /search-index.json) get
# their rules appended to dist/_headers by scripts/llms-full.mjs.

# The update feed (Sparkle reads it: SUFeedURL) and the dated price history
# (CuratedPriceHistory.remoteURL), both static files written by the release
# workflow (bin/publish-feeds.sh). A minute of caching, so a release, or an item
# pulled from the feed, reaches every client within minutes. CORS open, as
# GitHub Pages served them.
/appcast.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=60, stale-while-revalidate=300
  Access-Control-Allow-Origin: *
/price-history.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=60, stale-while-revalidate=300
  Access-Control-Allow-Origin: *
# The price history's JSON Schema (the API's service-desc: /.well-known/api-catalog).
/price-history.schema.json
  Content-Type: application/schema+json
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

# workers.dev (every branch preview, and production's workers.dev address whenever
# wrangler.jsonc turns it on) stays out of search results. _headers can match on host with an
# absolute URL, so this applies to the static assets only there; the Worker's own
# answer (/download/) adds the same header in worker/index.ts.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
