{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pacer",
  // The owner's personal "Eric Cloudflare" account (it holds the andrechek.com
  // zone). Pinned so a deploy from a machine signed into another account (the
  // local Wrangler login is a work account) fails instead of landing there.
  "account_id": "a83636122a9deb90dc326f3f97dc891e",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Astro emits dist/404.html; unknown paths get it with a 404 status.
    "not_found_handling": "404-page",
    // Everything is a static asset except what is listed here, which reaches
    // the Worker first (worker/index.ts): /download and /api/feedback, which
    // the Worker answers, and the update feed and price history, which it only
    // counts (`feed_request`). Those two are still static assets (public/): the
    // Worker returns the assets binding's own Response untouched and counts in
    // ctx.waitUntil, and falls back to the asset if anything of its own throws
    // (site/README.md, "The Worker"). Listing /appcast.xml puts update checks
    // under the Workers Free plan's account-wide daily request limit: past it,
    // these paths answer 429 until 00:00 UTC. 0.9.5+ then reads the feed from
    // raw.githubusercontent.com; 0.9.4 has no fallback and waits. Accepted by
    // the owner, 2026-11-25. Then the pages, for the Markdown router
    // (@wave-rf/cloudflare-md-router: the .md twin to agents that ask for it),
    // but not their twins, and the search endpoint (site/README.md, "Discovery
    // for agents"). The list is scripts/discovery.mjs's WORKER_ROUTES,
    // PAGE_ROUTES and SEARCH_ROUTES (worker/index.test.ts checks it). Every
    // path not listed never runs Worker code.
    "run_worker_first": [
      "/download",
      "/download/",
      "/api/feedback",
      "/appcast.xml",
      "/price-history.json",
      "/",
      "/features/",
      "/cli/",
      "/how-pacer-counts/",
      "/claude-prices/",
      "/privacy/",
      "/faq/",
      "/changelog/",
      "/compare/*",
      "!/compare/*.md",
      "/.well-known/search",
    ],
  },
  // PostHog for /download's one anonymous `website_download` event and the
  // feed's `feed_request` counts (worker/lib.ts).
  // The same project as the app; its token is public by design (it is compiled
  // into the app, project.yml). Empty POSTHOG_TOKEN turns the event off.
  // SENTRY_DSN: where /api/feedback forwards the app's feedback (worker/feedback.ts).
  // The app's own DSN (project.yml, PACER_SENTRY_DSN), a public client key by
  // design: it can only send, not read. Empty turns the endpoint off (503).
  "vars": {
    "POSTHOG_TOKEN": "phc_rCT9m6F6y7DwcDSJ5BgHpZECFyvpmsPoyUiLx5pa693A",
    "POSTHOG_HOST": "https://us.i.posthog.com",
    "SENTRY_DSN": "https://4538a70956bdb802f903aa6ceba5ba32@o4506596663427072.ingest.us.sentry.io/4512290674049024",
  },
  // Custom domain: the site, and from 0.9.4 the app's update feed (SUFeedURL)
  // and price history. Cloudflare creates the DNS record itself on the first
  // production deploy that carries this route (the merge that added it; no
  // record may exist for the name beforehand). scripts/indexnow.mjs only
  // submits when it is here.
  "routes": [{ "pattern": "pacer.andrechek.com", "custom_domain": true }],
  // Branch previews: Workers Builds runs `npx wrangler preview` for non-main
  // branches, served on workers.dev. Top-level settings apply.
  "previews": {},
  // Set explicitly, because left out it follows workers_dev (off below).
  // Cloudflare: "Disabling your workers.dev route does not disable Version
  // URLs, Preview URLs, or Deployment URLs" (Workers > Routing > workers.dev),
  // and "Production and Preview workers.dev URLs are configured separately"
  // (Workers > Previews > Custom domains). Preview answers carry
  // X-Robots-Tag: noindex (public/_headers, worker/index.ts, and Cloudflare's own).
  "preview_urls": true,
  // Production lives at one address. Keep it in this file: a workers.dev route
  // switched off only in the dashboard comes back on the next deploy.
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
}
