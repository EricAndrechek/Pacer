{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pacer",
  // The owner's personal "Eric Cloudflare" account (it holds the andrechek.com
  // zone). Pinned so a deploy from a machine signed into another account (the
  // local Wrangler login is a work account) fails instead of landing there.
  "account_id": "a83636122a9deb90dc326f3f97dc891e",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Astro emits dist/404.html; unknown paths get it with a 404 status.
    "not_found_handling": "404-page",
    // Everything is a static asset except /download, which the Worker answers
    // (worker/index.ts). Listing only it keeps every other request off the
    // Worker entirely. /appcast.xml and /price-history.json are static assets
    // on purpose (public/): the update feed must never depend on Worker code.
    "run_worker_first": ["/download", "/download/"],
  },
  // PostHog for /download's one anonymous `website_download` event (worker/index.ts).
  // The same project as the app; its token is public by design (it is compiled
  // into the app, project.yml). Empty POSTHOG_TOKEN turns the event off.
  "vars": {
    "POSTHOG_TOKEN": "phc_rCT9m6F6y7DwcDSJ5BgHpZECFyvpmsPoyUiLx5pa693A",
    "POSTHOG_HOST": "https://us.i.posthog.com",
  },
  // Custom domain: the site, and from 0.9.4 the app's update feed (SUFeedURL)
  // and price history. Cloudflare created the DNS record itself on the first
  // deploy that carried this route. scripts/indexnow.mjs only submits when it
  // is here.
  "routes": [{ "pattern": "pacer.andrechek.com", "custom_domain": true }],
  // Branch previews: Workers Builds runs `npx wrangler preview` for non-main
  // branches, served on workers.dev. Top-level settings apply.
  "previews": {},
  // Set explicitly, because left out it follows workers_dev (off below).
  // Cloudflare: "Disabling your workers.dev route does not disable Version
  // URLs, Preview URLs, or Deployment URLs" (Workers > Routing > workers.dev),
  // and "Production and Preview workers.dev URLs are configured separately"
  // (Workers > Previews > Custom domains). Preview answers carry
  // X-Robots-Tag: noindex (public/_headers, worker/index.ts, and Cloudflare's own).
  "preview_urls": true,
  // Production lives at one address. Keep it in this file: a workers.dev route
  // switched off only in the dashboard comes back on the next deploy.
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
}
