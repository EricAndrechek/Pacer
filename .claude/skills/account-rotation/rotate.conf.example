# Rotation thresholds. rotate.sh re-reads this file every loop, so a change
# here takes effect within a minute, with no restart. Plain bash assignments.

EARLY=2            # switch this many points before the active account's safe limit
# The 7d limit (leave the active account at it, never switch onto one near it).
# auto computes it from the weekly burn, like the 5h switch point: 100 minus how
# far 7d usage can climb before a fresher reading (the active account's 7d burn
# x (reading age + 5 min), at least 1 point), minus EARLY; 99 - EARLY with no
# burn from Pacer. A number fixes it for every slot instead.
WEEK_MAX=auto
# A per-slot cap overrides either, e.g. keep slot 1 under 90%:
#WEEK_MAX_1=90
STAGGER=9000       # 2.5 h: when the active window has this little left, start an idle one
MIN_SWITCH_GAP=300 # at most one switch per 5 min; never back to the slot just left within it
                   # unless that slot's 5h window has reset since

# A target needs room (5h points below ITS OWN switch point) for
# BRIDGE_MIN_MINUTES at the active account's recent burn, and never less than
# BRIDGE_MIN_PTS. Replaces ROOM_BELOW and GAP (2026-10-20): the controller needs
# no quota, so it can always switch back, but a bridge onto a few points
# released every waiting session at once and filled in minutes (22:03Z, 22:08Z).
BRIDGE_MIN_PTS=6
BRIDGE_MIN_MINUTES=20
BURN_UNKNOWN=40    # %/h assumed when Pacer gives no burn for the active account

# Use it or lose it: switch to an account whose running 5h window resets within
# EXPIRE_WINDOW seconds while it still has room for BRIDGE_MIN_MINUTES of burn
# (at least EXPIRE_MIN_PTS), if that reset comes before the active's own.
EXPIRE_WINDOW=2700 # 45 min
EXPIRE_MIN_PTS=8

# Per-slot 7d caps (WEEK_MAX_<slot>, above) override WEEK_MAX for that slot.
# Slots never chosen as a target (space-separated), e.g. EXCLUDE="4".
EXCLUDE=""

# Reserve: one slot past its 7d limit may be spent up to RESERVE_WEEK_MAX, only
# to unblock a 5h limit when nothing else has room. Off unless the owner names one
# (it was account 3 for the week of 2026-10-07 and overshot to 100%).
RESERVE_SLOT=""
RESERVE_WEEK_MAX=97

# A target also needs 7d room below the 7d limit: BRIDGE_MIN_MINUTES of the
# active account's 7d burn, rounded up, and never less than WEEK_ROOM_MIN points
# (one point of weekly room is a few minutes of work, then another switch).
WEEK_ROOM_MIN=1
